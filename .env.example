# Copia este archivo como ".env" (sin ".example") y pega tu clave real.
# Nunca compartas ni entregues el archivo .env.
# Clave gratuita (sin tarjeta): https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_aqui_tu_clave

# Opcionales
# FISIA_MODELO=gemini-4-hydrogen
# FISIA_MODELO_RAPIDO=gemini-4-hydrogen
# PORT=5000
# FISIA_HOST=0.0.0.0   # permite abrir la página desde otros equipos de tu red (ver README)
# FISIA_RPM=8              # peticiones por minuto hacia Gemini (baja a 5 si ves errores 429)
# FISIA_CONCURRENTES=2     # respuestas simultáneas
# FISIA_REINTENTOS=2       # reintentos por modelo cuando Gemini está saturado
# FISIA_RESPALDO=gemini-3.8-flash   # modelo de respaldo (vacío = sin respaldo)
# FISIA_MODELO_PROFUNDO=gemini-4-argon   # nivel "complejo" (Argon no está en el plan gratuito: si falla, usa el respaldo)
# FISIA_NIVEL=low          # razonamiento de Gemini 4: low (rápido), medium, high
# FISIA_TIMEOUT=180        # segundos máximos sin recibir respuesta de Gemini
